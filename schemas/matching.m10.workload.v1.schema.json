{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m10.workload.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seed",
    "fixedAdmissionScenarios",
    "generatedAdmissionModel",
    "admissionContract",
    "microbenchmark",
    "releaseOpenLoop",
    "ciSmoke",
    "saturation",
    "releaseSoak",
    "resourceDimensions",
    "correctnessContract",
    "coverageRequirements",
    "requiredMutants",
    "tutorialPermalinks"
  ],
  "properties": {
    "schemaVersion": {"const": "matching.m10.workload.v1"},
    "seed": {"const": "6010"},
    "fixedAdmissionScenarios": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proofObligations"],
        "properties": {
          "id": {"$ref": "#/$defs/scenarioId"},
          "proofObligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/obligationId"}
          }
        }
      }
    },
    "generatedAdmissionModel": {"$ref": "#/$defs/generated"},
    "admissionContract": {"$ref": "#/$defs/admission"},
    "microbenchmark": {"$ref": "#/$defs/micro"},
    "releaseOpenLoop": {"$ref": "#/$defs/releaseOpenLoop"},
    "ciSmoke": {"$ref": "#/$defs/ciSmoke"},
    "saturation": {"$ref": "#/$defs/saturation"},
    "releaseSoak": {"$ref": "#/$defs/releaseSoak"},
    "resourceDimensions": {
      "const": ["ALLOCATION", "GC", "CPU", "MEMORY", "QUEUE_DEPTH"]
    },
    "correctnessContract": {"$ref": "#/$defs/correctness"},
    "coverageRequirements": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/obligationId"}
    },
    "requiredMutants": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mutantId"}
    },
    "tutorialPermalinks": {
      "const": [
        "performance-contract-and-open-loop-workload",
        "bounded-admission-and-overload-semantics",
        "percentiles-knee-point-and-capacity-envelope",
        "allocation-gc-resource-and-soak-evidence",
        "matching-0-5-0-release-evidence"
      ]
    }
  },
  "$defs": {
    "scenarioId": {
      "enum": [
        "CAPACITY_REJECTS_NON_POSITIVE",
        "TRY_SUBMIT_OWNS_CALLER_BYTES",
        "FULL_QUEUE_REJECTS_IMMEDIATELY",
        "OVERLOAD_REJECTION_PRECEDES_WAL",
        "OVERLOAD_REJECTION_PRESERVES_IDENTITY",
        "ENQUEUE_IS_NOT_DURABLE_ACK",
        "ONE_WORKER_PRESERVES_FIFO",
        "SUBMISSION_RESULT_PASSES_THROUGH_UNCHANGED",
        "CHECKPOINT_RETRY_REUSES_ENVELOPE",
        "CHECKPOINT_PAUSE_COUNTS_IN_LATENCY",
        "WORKER_FAILURE_CLOSES_ADMISSION",
        "ACCEPTED_PENDING_COMMANDS_FAIL_EXPLICITLY",
        "QUIESCE_REJECTS_NEW_OFFERS",
        "QUIESCE_DRAINS_ACCEPTED_OFFERS",
        "OFFER_AND_COMPLETION_TOTALS_RECONCILE",
        "OPEN_LOOP_USES_SCHEDULED_ARRIVAL",
        "RAW_SAMPLES_RECONCILE_PERCENTILES",
        "ENVIRONMENT_AND_MICRO_RESULTS_ARE_SEPARATE",
        "KNEE_AND_ABOVE_KNEE_ARE_EXPLICIT",
        "LOAD_RECOVERY_REMAINS_EXACT"
      ]
    },
    "obligationId": {
      "enum": [
        "POSITIVE_FINITE_CAPACITY",
        "TRY_SUBMIT_NON_BLOCKING",
        "CALLER_BYTES_OWNED",
        "FULL_REJECTS_OVERLOADED",
        "REJECTION_PRE_WAL",
        "REJECTION_PRE_APPLY_IDENTITY",
        "ENQUEUE_NOT_ACK",
        "SINGLE_WORKER_FIFO",
        "SUBMISSION_RESULT_UNCHANGED",
        "CHECKPOINT_SAME_ENVELOPE_RETRY",
        "CHECKPOINT_LATENCY_INCLUDED",
        "FAILURE_CLOSES_ADMISSION",
        "PENDING_EXPLICIT_FAILURE",
        "QUIESCE_REJECTS_NEW",
        "QUIESCE_DRAINS_ACCEPTED",
        "QUEUE_BOUNDED",
        "OFFER_RECONCILIATION",
        "COMPLETION_RECONCILIATION",
        "OPEN_LOOP_INDEPENDENT",
        "SCHEDULED_ARRIVAL_ORIGIN",
        "RAW_PERCENTILE_RECONCILIATION",
        "ENVIRONMENT_FINGERPRINT",
        "MICRO_E2E_SEPARATED",
        "DETERMINISTIC_KNEE",
        "ABOVE_KNEE_EXPLICIT_REJECTION",
        "RESOURCE_DIMENSIONS_PRESENT",
        "LOAD_REPLAY_RECOVERY_EXACT",
        "SYSTEM_ERROR_NEVER_PASS"
      ]
    },
    "mutantId": {
      "enum": [
        "M10-UNBOUNDED-QUEUE",
        "M10-BLOCKING-PUT",
        "M10-REJECT-AFTER-WAL",
        "M10-REJECT-BINDS-IDENTITY",
        "M10-ENQUEUE-AS-ACK",
        "M10-DUAL-WORKER-REORDER",
        "M10-DROPPED-COMPLETION",
        "M10-METRICS-UNDERCOUNT",
        "M10-CLOSED-LOOP-GENERATOR",
        "M10-LATENCY-FROM-ACTUAL-SEND",
        "M10-WRONG-PERCENTILE-KNEE",
        "M10-SKIP-LOAD-RECOVERY-CHECK"
      ]
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "histories", "actionsPerHistory", "totalActions", "lanes"],
      "properties": {
        "algorithm": {"const": "splitmix64-v1"},
        "histories": {"const": 64},
        "actionsPerHistory": {"const": 256},
        "totalActions": {"const": 16384},
        "lanes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "historyModulo"],
            "properties": {
              "id": {"enum": ["BELOW_CAPACITY", "QUEUE_FULL", "CHECKPOINT_PAUSE", "FAIL_CLOSE_RETRY"]},
              "historyModulo": {"type": "integer", "minimum": 0, "maximum": 3}
            }
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueCapacity", "submission", "callerBytes", "fullResult", "workerModel", "acceptedCompletion", "failureMode", "quiesce"],
      "properties": {
        "queueCapacity": {"const": 64},
        "submission": {"const": "TRY_SUBMIT_NON_BLOCKING"},
        "callerBytes": {"const": "OWNED_BEFORE_RETURN"},
        "fullResult": {"const": "OVERLOADED_BEFORE_WAL"},
        "workerModel": {"const": "ONE_CALLER_SERIALIZED_LOCAL_RUNTIME_WORKER"},
        "acceptedCompletion": {"const": "EXACTLY_ONE_SUBMISSION_RESULT_OR_EXPLICIT_FAILURE"},
        "failureMode": {"const": "CLOSE_ADMISSION_AND_FAIL_PENDING"},
        "quiesce": {"const": "REJECT_NEW_THEN_DRAIN_ACCEPTED"}
      }
    },
    "micro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "mode", "resultScope", "releaseGate"],
      "properties": {
        "harness": {"const": "JMH"},
        "mode": {"const": "SampleTime"},
        "resultScope": {"const": "DIAGNOSTIC_ONLY"},
        "releaseGate": {"const": false}
      }
    },
    "releaseOpenLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "generator", "latencyOrigin", "calibration", "sweeps", "warmupSecondsPerRate", "measurementSecondsPerRate", "rateLadderPermille", "percentiles", "resultScope"],
      "properties": {
        "profileId": {"const": "RELEASE_QUALIFICATION"},
        "generator": {"const": "OPEN_LOOP_SCHEDULED_ARRIVALS"},
        "latencyOrigin": {"const": "SCHEDULED_ARRIVAL"},
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "seconds", "purpose"],
          "properties": {
            "mode": {"const": "UNPACED"},
            "seconds": {"const": 20},
            "purpose": {"const": "RATE_SELECTION_ONLY"}
          }
        },
        "sweeps": {"const": 3},
        "warmupSecondsPerRate": {"const": 10},
        "measurementSecondsPerRate": {"const": 30},
        "rateLadderPermille": {"const": [250, 500, 700, 850, 1000, 1150, 1350, 1600]},
        "percentiles": {"const": [0.5, 0.95, 0.99, 0.999]},
        "resultScope": {"const": "RELEASE_QUALIFICATION"}
      }
    },
    "ciSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "generator", "latencyOrigin", "calibrationSeconds", "sweeps", "warmupSecondsPerRate", "measurementSecondsPerRate", "rateLadderPermille", "percentiles", "soakSeconds", "resultScope", "eligibleForReleaseEvidence"],
      "properties": {
        "profileId": {"const": "CI_SMOKE"},
        "generator": {"const": "OPEN_LOOP_SCHEDULED_ARRIVALS"},
        "latencyOrigin": {"const": "SCHEDULED_ARRIVAL"},
        "calibrationSeconds": {"const": 1},
        "sweeps": {"const": 1},
        "warmupSecondsPerRate": {"const": 1},
        "measurementSecondsPerRate": {"const": 2},
        "rateLadderPermille": {"const": [250, 500, 700, 850, 1000, 1150, 1350, 1600]},
        "percentiles": {"const": [0.5, 0.95, 0.99, 0.999]},
        "soakSeconds": {"const": 3},
        "resultScope": {"const": "METHOD_SMOKE_ONLY"},
        "eligibleForReleaseEvidence": {"const": false}
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overloadRejectCount", "p99QueueDepthPermilleOfCapacity", "minimumCompletedPerAdmittedPermille", "maximumEndBacklogGrowthPermilleOfCapacity", "perSweepKnee", "publishedKnee", "qualifiedOperatingPoint"],
      "properties": {
        "overloadRejectCount": {"const": "GREATER_THAN_ZERO"},
        "p99QueueDepthPermilleOfCapacity": {"const": 800},
        "minimumCompletedPerAdmittedPermille": {"const": 995},
        "maximumEndBacklogGrowthPermilleOfCapacity": {"const": 100},
        "perSweepKnee": {"const": "FIRST_OF_TWO_CONSECUTIVE_SATURATED_RATES"},
        "publishedKnee": {"const": "MIN_OF_THREE_SWEEP_KNEES"},
        "qualifiedOperatingPoint": {"const": "FLOOR_70_PERCENT_OF_PUBLISHED_KNEE"}
      }
    },
    "releaseSoak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load", "durationSeconds", "resultScope"],
      "properties": {
        "load": {"const": "QUALIFIED_OPERATING_POINT"},
        "durationSeconds": {"const": 1800},
        "resultScope": {"const": "RELEASE_QUALIFICATION"}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedCommands", "overloadRejections", "loadThenRecovery", "systemError"],
      "properties": {
        "acceptedCommands": {"const": "PASS_THROUGH_SUBMISSION_RESULT_AND_MATCH_DURABLE_TRANSCRIPT"},
        "overloadRejections": {"const": "NEVER_MUTATE_WAL_IDENTITY_OR_MATCHING_STATE"},
        "loadThenRecovery": {"const": "EXACT_CANONICAL_RESULT_AND_STATE_DIGEST"},
        "systemError": {"const": "NEVER_PASS_OR_MUTANT_KILL"}
      }
    }
  }
}
