{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m06.scenario.v1.schema.json",
  "title": "Matching M06 fixed market-mode and Mass Cancel scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "matching.m06.scenario.v1"},
    "scenarios": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "proofObligations", "commands"],
      "properties": {
        "scenarioId": {"enum": ["BOOTSTRAP_OPEN_REGRESSION", "CANCEL_ONLY_PERMISSION", "HALTED_CUSTOMER_PERMISSION", "SAFE_REOPEN_GRAPH", "STALE_APPLICATION_FENCE", "STALE_EXPECTED_MODE", "MODE_FAILURE_ATOMICITY", "TRANSITION_DOES_NOT_CLEAR_BOOK", "MASS_CANCEL_REQUIRES_HALT", "EMPTY_BOOK_MASS_CANCEL", "BID_ONLY_ACCEPTANCE_ORDER", "ASK_ONLY_ACCEPTANCE_ORDER", "CROSS_SIDE_GLOBAL_ACCEPTANCE_ORDER", "TERMINAL_IDENTITY_LATE_CANCEL", "RULE_SET_ATTRIBUTION_PRESERVED"]},
        "proofObligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/coverageId"}},
        "commands": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/command"}}
      }
    },
    "command": {
      "oneOf": [
        {"$ref": "#/$defs/legacyPlace"},
        {"$ref": "#/$defs/governedPlace"},
        {"$ref": "#/$defs/cancel"},
        {"$ref": "#/$defs/prepare"},
        {"$ref": "#/$defs/activate"},
        {"$ref": "#/$defs/changeMarketMode"},
        {"$ref": "#/$defs/massCancel"}
      ]
    },
    "legacyPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "entrypoint", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "PLACE"},
        "entrypoint": {"const": "LEGACY"},
        "input": {"$ref": "#/$defs/placeInput"}
      }
    },
    "governedPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "entrypoint", "expectedRuleSet", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "PLACE"},
        "entrypoint": {"const": "GOVERNED"},
        "expectedRuleSet": {"$ref": "#/$defs/identity"},
        "input": {"$ref": "#/$defs/placeInput"}
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "CANCEL"},
        "input": {"$ref": "#/$defs/cancelInput"}
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "PREPARE_RULE_SET"},
        "input": {"$ref": "#/$defs/prepareInput"}
      }
    },
    "activate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "ACTIVATE_RULE_SET"},
        "input": {"$ref": "#/$defs/activateInput"}
      }
    },
    "changeMarketMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "CHANGE_MARKET_MODE"},
        "input": {"$ref": "#/$defs/changeMarketModeInput"}
      }
    },
    "massCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "type", "input"],
      "properties": {
        "caseId": {"$ref": "#/$defs/caseId"},
        "type": {"const": "MASS_CANCEL"},
        "input": {"$ref": "#/$defs/massCancelInput"}
      }
    },
    "caseId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "positiveLong": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "nonNegativeLong": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "mode": {"enum": ["OPEN", "CANCEL_ONLY", "HALTED"]},
    "operatorId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*"},
    "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "contentHash"],
      "properties": {
        "version": {"$ref": "#/$defs/nonNegativeLong"},
        "contentHash": {"$ref": "#/$defs/contentHash"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "instrumentId", "version", "lowerInclusive", "upperInclusive", "contentHash"],
      "properties": {
        "schemaVersion": {"const": "matching.market-rule-set.v1"},
        "instrumentId": {"const": "BTC-USDT"},
        "version": {"$ref": "#/$defs/nonNegativeLong"},
        "lowerInclusive": {"$ref": "#/$defs/positiveLong"},
        "upperInclusive": {"$ref": "#/$defs/positiveLong"},
        "contentHash": {"$ref": "#/$defs/contentHash"}
      }
    },
    "placeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentId", "orderId", "side", "priceTicks", "quantityLots", "executionPolicy"],
      "properties": {
        "instrumentId": {"type": "string", "minLength": 1, "maxLength": 64},
        "orderId": {"$ref": "#/$defs/nonNegativeLong"},
        "side": {"type": "string", "minLength": 1, "maxLength": 16},
        "priceTicks": {"$ref": "#/$defs/nonNegativeLong"},
        "quantityLots": {"$ref": "#/$defs/nonNegativeLong"},
        "executionPolicy": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "cancelInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentId", "orderId"],
      "properties": {
        "instrumentId": {"type": "string", "minLength": 1, "maxLength": 64},
        "orderId": {"$ref": "#/$defs/nonNegativeLong"}
      }
    },
    "prepareInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedActive", "artifact"],
      "properties": {
        "expectedActive": {"$ref": "#/$defs/identity"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "activateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedApplicationSequence", "expectedActive", "target"],
      "properties": {
        "expectedApplicationSequence": {"$ref": "#/$defs/positiveLong"},
        "expectedActive": {"$ref": "#/$defs/identity"},
        "target": {"$ref": "#/$defs/identity"}
      }
    },
    "changeMarketModeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedApplicationSequence", "expectedMode", "targetMode", "operatorId"],
      "properties": {
        "expectedApplicationSequence": {"$ref": "#/$defs/positiveLong"},
        "expectedMode": {"$ref": "#/$defs/mode"},
        "targetMode": {"$ref": "#/$defs/mode"},
        "operatorId": {"$ref": "#/$defs/operatorId"}
      }
    },
    "massCancelInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedApplicationSequence", "expectedMode", "operatorId"],
      "properties": {
        "expectedApplicationSequence": {"$ref": "#/$defs/positiveLong"},
        "expectedMode": {"$ref": "#/$defs/mode"},
        "operatorId": {"$ref": "#/$defs/operatorId"}
      }
    },
    "coverageId": {"enum": ["BOOTSTRAP_OPEN", "VALID_MODE_TRANSITION", "DIRECT_REOPEN_REJECTED", "SAME_MODE_REJECTED", "STALE_APPLICATION_FENCE", "STALE_EXPECTED_MODE", "MODE_FAILURE_ATOMIC", "PLACE_OPEN_ALLOWED", "PLACE_CANCEL_ONLY_REJECTED", "PLACE_HALTED_REJECTED", "CANCEL_OPEN_ALLOWED", "CANCEL_CANCEL_ONLY_ALLOWED", "CANCEL_HALTED_REJECTED", "RULE_CONTROL_ALL_MODES", "TRANSITION_BOOK_UNCHANGED", "MASS_CANCEL_REQUIRES_HALTED", "MASS_CANCEL_EMPTY_SUCCESS", "MASS_CANCEL_GLOBAL_ACCEPTANCE_ORDER", "MASS_CANCEL_BID_SIDE", "MASS_CANCEL_ASK_SIDE", "MASS_CANCEL_CROSS_PRICE", "MASS_CANCEL_TERMINAL_IDENTITY", "MASS_CANCEL_RULE_ATTRIBUTION", "MASS_CANCEL_ACTIVE_RULE_UNCHANGED", "APPLICATION_SEQUENCE_CONTINUITY", "LEGACY_M00_M05_COMPATIBILITY"]}
  }
}
