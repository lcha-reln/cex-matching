{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m09.counterexamples.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "unit", "counterexamples"],
  "properties": {
    "schemaVersion": {"const": "matching.m09.counterexamples.v1"},
    "unit": {"const": "M09"},
    "counterexamples": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/counterexample"}
    }
  },
  "$defs": {
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutantId",
        "classification",
        "propertyFingerprint",
        "rawOperations",
        "minimalOperations",
        "shrinkTrials",
        "freshRuntime",
        "realSnapshotOrWalFiles",
        "strictReplay",
        "operationInterpreter",
        "interpretedOperations",
        "oneMinimal",
        "singleDeletePasses",
        "singleDeleteInvalidHistories",
        "singleDeleteDifferentStudentFailures",
        "singleDeleteSameFingerprintStudentFailures",
        "systemErrorCountedAsKill",
        "actualMutationActions",
        "operations"
      ],
      "properties": {
        "mutantId": {"type": "string", "pattern": "^M09-[A-Z0-9-]+$"},
        "classification": {"const": "STUDENT_FAILURE"},
        "propertyFingerprint": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "rawOperations": {"type": "integer", "minimum": 1},
        "minimalOperations": {"type": "integer", "minimum": 1},
        "shrinkTrials": {"type": "integer", "minimum": 1},
        "freshRuntime": {"const": true},
        "realSnapshotOrWalFiles": {"const": true},
        "strictReplay": {"const": true},
        "operationInterpreter": {"const": true},
        "interpretedOperations": {"type": "integer", "minimum": 1},
        "oneMinimal": {"const": true},
        "singleDeletePasses": {"type": "integer", "minimum": 0},
        "singleDeleteInvalidHistories": {"type": "integer", "minimum": 0},
        "singleDeleteDifferentStudentFailures": {"type": "integer", "minimum": 0},
        "singleDeleteSameFingerprintStudentFailures": {"const": 0},
        "systemErrorCountedAsKill": {"const": false},
        "actualMutationActions": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    }
  }
}
