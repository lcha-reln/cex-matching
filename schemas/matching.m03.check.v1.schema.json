    "missingCapabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "const": "INDEPENDENT_REFERENCE_MODEL" },
        { "const": "DETERMINISTIC_HISTORY_GENERATOR" },
        { "const": "STATEFUL_DIFFERENTIAL_PROPERTY_JUDGE" },
        { "const": "DETERMINISTIC_COUNTEREXAMPLE_SHRINKER" },
        { "const": "REPLAYABLE_COUNTEREXAMPLE_ARTIFACT" }
