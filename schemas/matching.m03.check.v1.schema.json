  "properties": {
    "schemaVersion": { "const": "matching.m03.check.v1" },
    "unit": { "const": "M03" },
    "status": { "const": "GOAL_NOT_IMPLEMENTED" },
    "contractPlanVersion": { "const": "0.5" },
    "objective": {
      "const": "Prove the M02 matcher against an independent generated reference model with persisted minimal counterexamples."
    },
    "inheritedM02": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkSchemaVersion", "scenarios", "commands", "canonicalDigest"],
      "properties": {
        "status": { "const": "PASS" },
        "checkSchemaVersion": { "const": "matching.m02.check.v2" },
        "scenarios": { "const": 10 },
        "commands": { "const": 34 },
        "canonicalDigest": {
          "const": "sha256:32054d63accba99b19db823c41f74bda73dc3b8a009b528f2834d2bc70839d16"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaPath",
        "sha256",
        "algorithm",
        "baseSeed",
        "histories",
        "commandsPerHistory",
        "totalCommands",
        "lanes",
        "historiesPerLane",
        "schemaProbes"
      ],
      "properties": {
        "path": {
          "const": "matching-testkit/src/test/resources/m03/fixtures/property-suite-v1.json"
        },
        "schemaPath": { "const": "schemas/matching.m03.generator.v1.schema.json" },
        "sha256": {
          "const": "3e051347b9bd42aac431d02949c0c1b72daa667d10a03cc8aeb09a6b5a74d24e"
        },
        "algorithm": { "const": "splitmix64-v1" },
        "baseSeed": { "const": "6824" },
        "histories": { "const": 256 },
        "commandsPerHistory": { "const": 64 },
        "totalCommands": { "const": 16384 },
        "lanes": { "const": 4 },
        "historiesPerLane": { "const": 64 },
        "schemaProbes": { "const": 6 }
      }
    },
    "independenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "coreDependency",
        "testkitDependency",
        "semanticSources",
        "representation"
